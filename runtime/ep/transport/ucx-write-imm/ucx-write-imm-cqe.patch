+UCS_F_DEVICE ucs_status_t uct_rc_mlx5_gda_ep_advance_rx(
+        uct_device_ep_h tl_ep, unsigned channel_id, uint64_t consumed,
+        uint64_t *consumer_index_p)
+{
+    auto ep = reinterpret_cast<uct_rc_gdaki_dev_ep_t*>(tl_ep);
+    auto cid = channel_id & ep->channel_mask;
+    auto qp = uct_rc_mlx5_gda_get_qp(ep, cid);
+    const uint32_t ci = static_cast<uint32_t>(qp->rx_cq_ci + consumed);
+    const uint32_t rx_rq_pi = ci + ep->rq_wqe_num;
+    qp->rx_cq_ci = ci;
+    // Equal CQ/RQ depths: new RQ credits enable reuse of consumed CQ slots.
+    // The RQ release orders prior CQE reads and the CQ DBR update before reuse.
+    const uint32_t cq_db = doca_gpu_dev_verbs_bswap32(ci & 0x00ffffffu);
+    asm volatile("st.relaxed.sys.global.b32 [%0], %1;"
+                 :: "l"(&qp->rx_cq_dbrec[0]), "r"(cq_db) : "memory");
+    const uint32_t rq_db = doca_gpu_dev_verbs_bswap32(rx_rq_pi & 0xffffu);
+    asm volatile("st.release.sys.global.b32 [%0], %1;"
+                 :: "l"(&qp->qp_dbrec[MLX5_RCV_DBR]), "r"(rq_db) : "memory");
+    *consumer_index_p = ci;
+    return UCS_OK;
 }
 
