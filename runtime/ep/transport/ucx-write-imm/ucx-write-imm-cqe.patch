+/* Readers may scan a receive CQ with private cursors. One finalizer returns
+ * CQ/RQ credits after synchronizing every reader's payload use. */
+UCS_F_DEVICE ucs_status_t uct_rc_mlx5_gda_ep_poll_imm_at(
+        uct_device_ep_h tl_ep, unsigned channel_id, uint64_t *consumer_index,
+        uint32_t *immediate)
+{
+    auto ep = reinterpret_cast<uct_rc_gdaki_dev_ep_t*>(tl_ep);
+    auto cid = channel_id & ep->channel_mask;
+    auto qp = uct_rc_mlx5_gda_get_qp(ep, cid);
+    const uint64_t ci = *consumer_index;
+    auto cqe = reinterpret_cast<mlx5_cqe64*>(qp->rx_cq_daddr) + (ci & (ep->rq_wqe_num - 1));
+    const uint8_t opown = doca_gpu_dev_verbs_load_relaxed_sys_global(&cqe->op_own);
+    if ((opown & 1) != !!(ci & ep->rq_wqe_num)) {
+        return UCS_INPROGRESS;
+    }
+    asm volatile("fence.acquire.sys;" ::: "memory");
+
+    const unsigned opcode = opown >> 4;
+    const uint16_t wqe_counter = doca_gpu_dev_verbs_bswap32(
+            doca_gpu_dev_verbs_load_relaxed_sys_global(
+                    reinterpret_cast<uint32_t*>(&cqe->wqe_counter))) >> 16;
+    const uint32_t cqe_qpn = doca_gpu_dev_verbs_bswap32(
+            doca_gpu_dev_verbs_load_relaxed_sys_global(&cqe->sop_drop_qpn)) & 0x00ffffffu;
+    const uint32_t value = doca_gpu_dev_verbs_bswap32(
+            doca_gpu_dev_verbs_load_relaxed_sys_global(&cqe->imm_inval_pkey));
+    if ((opcode != DOCA_GPUNETIO_IB_MLX5_CQE_RESP_WR_IMM) ||
+        (wqe_counter != static_cast<uint16_t>(ci)) ||
+        (cqe_qpn != qp->sq_num)) {
+        // Includes request/response error CQEs and unexpected operations.
+        return UCS_ERR_IO_ERROR;
+    }
+    *consumer_index = ci + 1;
+    *immediate = value;
+
+    return UCS_OK;
+}
