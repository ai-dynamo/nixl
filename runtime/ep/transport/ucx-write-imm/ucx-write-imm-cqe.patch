From 535ea491c5ea706d44a6cbadbfdec2e256314205 Mon Sep 17 00:00:00 2001
From: Alexander Grissik <agrissik@nvidia.com>
Date: Mon, 23 Nov 2026 08:11:05 +0000
Subject: [PATCH] UCT/GDA: Support GPU polling of RDMA writes with immediate

Apply to openucx/ucx at 74b413ab19d63c277ffa3fb553ed83e42bc50f6f
(UCX 1.24.0).

When UCX_RC_GDA_RX_QUEUE_LEN is nonzero, create a private receive
queue and CQ per GDA channel and prepost empty receive WQEs. The
default depth is zero.

Expose device APIs to send a 32-bit immediate and poll its receive CQE.
Each reader advances its own cursor so GPU warps can share a CQ.
After all readers finish, one caller advances the shared consumer index
by the consumed count and publishes CQ progress before returning RQ credits.

diff --git a/src/ucp/api/device/ucp_device_impl.h b/src/ucp/api/device/ucp_device_impl.h
index 51cc311b3c87c272ff68341f4aa7e48aa8c06ab3..590b572dc76b478a6a180218f7228655297433bc 100644
--- a/src/ucp/api/device/ucp_device_impl.h
+++ b/src/ucp/api/device/ucp_device_impl.h
@@ -249,6 +249,106 @@ ucp_device_put(const ucp_device_local_mem_list_h src_mem_list_h,
 }
 
 
+/**
+ * @ingroup UCP_DEVICE
+ * @brief Post one RDMA write with an immediate receive CQE.
+ *
+ * Uses the same lane/channel mapping and arguments as ucp_device_put, plus
+ * the host-order 32-bit immediate. Previous writes on that same QP precede
+ * its receive completion. The destination must drain ucp_device_poll_imm_at;
+ * no payload word or atomic notification is substituted by this operation.
+ * This implementation requires exactly one device lane on each peer.
+ */
+template<ucs_device_level_t level = UCS_DEVICE_LEVEL_THREAD>
+UCS_F_DEVICE ucs_status_t ucp_device_put_imm(
+        const ucp_device_local_mem_list_h src_mem_list_h,
+        unsigned src_mem_list_index, size_t src_offset,
+        const ucp_device_remote_mem_list_h dst_mem_list_h,
+        unsigned dst_mem_list_index, size_t dst_offset, size_t length,
+        uint32_t immediate, unsigned channel_id, uint64_t flags,
+        ucp_device_request_t *req)
+{
+    unsigned uct_channel_id, lane;
+    const void *address;
+    const uct_device_mem_elem_t *uct_elem, *src_uct_elem;
+    uint64_t remote_address;
+    uct_device_completion_t *comp;
+    uct_device_ep_t *device_ep;
+    ucs_status_t status;
+
+    if ((src_mem_list_h->num_lanes != 1) ||
+        (dst_mem_list_h->num_lanes != 1)) {
+        return UCS_ERR_UNSUPPORTED;
+    }
+    UCP_DEVICE_GET_LANE(dst_mem_list_h, channel_id, lane, uct_channel_id);
+    status = ucp_device_prepare_send(src_mem_list_h, src_mem_list_index,
+            dst_mem_list_h, dst_mem_list_index, address, remote_address,
+            lane, req, device_ep, src_uct_elem, uct_elem, comp);
+    if (status != UCS_OK) {
+        return status;
+    }
+    return UCP_DEVICE_SEND_BLOCKING(level, uct_device_ep_put_imm, device_ep,
+            req, src_uct_elem, uct_elem,
+            UCS_PTR_BYTE_OFFSET(address, src_offset),
+            remote_address + dst_offset, length, immediate, uct_channel_id,
+            flags, comp);
+}
+
+/**
+ * @ingroup UCP_DEVICE
+ * @brief Poll a receive CQ with a caller-owned full-width consumer index.
+ *
+ * UCS_OK acquires system scope and advances only *consumer_index_p. Multiple
+ * readers may independently scan the same CQ. All readers must finish using
+ * the payloads before one finalizer calls ucp_device_advance_rx.
+ * No credits or shared consumer index are updated by this operation.
+ */
+UCS_F_DEVICE ucs_status_t ucp_device_poll_imm_at(
+        const ucp_device_remote_mem_list_h mem_list_h, unsigned index,
+        unsigned channel_id, uint64_t *consumer_index_p, uint32_t *immediate_p)
+{
+    ucs_status_t status = ucp_device_check_params(mem_list_h, index);
+    unsigned lane, uct_channel_id;
+    if (status != UCS_OK) {
+        return status;
+    }
+    if (mem_list_h->num_lanes != 1) {
+        return UCS_ERR_UNSUPPORTED;
+    }
+    UCP_DEVICE_GET_LANE(mem_list_h, channel_id, lane, uct_channel_id);
+    const auto elem = UCP_DEVICE_GET_ELEM(mem_list_h, index);
+    return uct_device_ep_poll_imm_at(elem->tl[lane].ep, uct_channel_id,
+                                    consumer_index_p, immediate_p);
+}
+
+/**
+ * @ingroup UCP_DEVICE
+ * @brief Advance the receive consumer index and return CQ/RQ credits.
+ *
+ * One finalizer calls this after synchronizing all readers' payload use. The
+ * count must account for exactly the completed receives since the last advance;
+ * the entire interval must fit the receive capacity without replenishment.
+ * No reader may still be scanning the retired entries when credits are returned.
+ * On success, consumer_index_p receives the new index, wrapping at 32 bits.
+ */
+UCS_F_DEVICE ucs_status_t ucp_device_advance_rx(
+        const ucp_device_remote_mem_list_h mem_list_h, unsigned index,
+        unsigned channel_id, uint64_t consumed, uint64_t *consumer_index_p)
+{
+    ucs_status_t status = ucp_device_check_params(mem_list_h, index);
+    unsigned lane, uct_channel_id;
+    if (status != UCS_OK) {
+        return status;
+    }
+    if (mem_list_h->num_lanes != 1) {
+        return UCS_ERR_UNSUPPORTED;
+    }
+    UCP_DEVICE_GET_LANE(mem_list_h, channel_id, lane, uct_channel_id);
+    const auto elem = UCP_DEVICE_GET_ELEM(mem_list_h, index);
+    return uct_device_ep_advance_rx(elem->tl[lane].ep, uct_channel_id, consumed,
+                                    consumer_index_p);
+}
+
 /**
  * @ingroup UCP_DEVICE
  * @brief Posts one memory increment operation.
diff --git a/src/uct/api/device/uct_device_impl.h b/src/uct/api/device/uct_device_impl.h
index 48f9c7560c86150aeaa8d8c5b3e9199226ad0055..a6a6dbbd46ce358662bbf579be9a04799d42b2ce 100644
--- a/src/uct/api/device/uct_device_impl.h
+++ b/src/uct/api/device/uct_device_impl.h
@@ -130,6 +130,117 @@ UCS_F_DEVICE ucs_status_t uct_device_ep_put(
 }
 
 
+/**
+ * @ingroup UCT_DEVICE
+ * @brief Posts one memory put operation with immediate data.
+ *
+ * This device routine writes a single memory block from @a address to
+ * @a remote_address and produces a remote receive completion carrying
+ * @a immediate. The local memory element @a src_uct_elem and remote memory
+ * element @a mem_elem must describe the transferred memory regions.
+ *
+ * User can pass @a comp to track sender-side completion. The remote peer polls
+ * the receive completion using @ref uct_device_ep_poll_imm_at.
+ *
+ * @param [in]  device_ep       Device endpoint to be used for the operation.
+ * @param [in]  src_uct_elem    Local memory element for the source region.
+ * @param [in]  mem_elem        Remote memory element for the destination region.
+ * @param [in]  address         Local virtual address to send data from.
+ * @param [in]  remote_address  Remote virtual address to write data to.
+ * @param [in]  length          Length in bytes of the data to send.
+ * @param [in]  immediate       Host-order 32-bit value in the remote completion.
+ * @param [in]  channel_id      Channel ID to use for the transfer.
+ * @param [in]  flags           Flags to modify the function behavior.
+ * @param [in]  comp            Completion object to track the progress of operation.
+ *
+ * @return UCS_INPROGRESS     - Operation successfully posted, use @ref
+ *                              uct_device_ep_progress and @ref
+ *                              uct_device_ep_check_completion to
+ *                              check for completion.
+ * @return UCS_ERR_NO_RESOURCE - No send queue space; retry the operation.
+ * @return UCS_ERR_UNSUPPORTED - Operation is unsupported by the transport.
+ * @return Error code as defined by @ref ucs_status_t
+ */
+template<ucs_device_level_t level>
+UCS_F_DEVICE ucs_status_t uct_device_ep_put_imm(
+        uct_device_ep_h device_ep, const uct_device_mem_elem_t *src_uct_elem,
+        const uct_device_mem_elem_t *mem_elem, const void *address,
+        uint64_t remote_address, size_t length, uint32_t immediate,
+        unsigned channel_id, uint64_t flags, uct_device_completion_t *comp)
+{
+#if UCT_RC_MLX5_GDA_SUPPORTED
+    if (device_ep->uct_tl_id == UCT_DEVICE_TL_RC_MLX5_GDA) {
+        return uct_rc_mlx5_gda_ep_put_imm<level>(device_ep, src_uct_elem,
+                mem_elem, address, remote_address, length, immediate,
+                channel_id, flags, comp);
+    }
+#endif
+    return UCS_ERR_UNSUPPORTED;
+}
+
+/**
+ * @ingroup UCT_DEVICE
+ * @brief Polls a receive completion with immediate data.
+ *
+ * This device routine polls the channel's receive CQ at @a consumer_index_p.
+ * On success, it performs a system-scope acquire, returns the immediate value,
+ * and advances only the caller's index. Each reader uses its own index; shared
+ * queue indices and receive credits are unchanged.
+ *
+ * @param [in]     device_ep         Device endpoint to be used for the operation.
+ * @param [in]     channel_id        Channel ID whose receive CQ is polled.
+ * @param [in,out] consumer_index_p  Caller-owned index of the next CQ entry.
+ * @param [out]    immediate_p       Host-order 32-bit value from the completion.
+ *
+ * @return UCS_OK              - Completion read and caller's index advanced.
+ * @return UCS_INPROGRESS      - No completion is ready at the supplied index.
+ * @return UCS_ERR_UNSUPPORTED - Operation is unsupported by the transport.
+ * @return Error code as defined by @ref ucs_status_t
+ */
+UCS_F_DEVICE ucs_status_t uct_device_ep_poll_imm_at(
+        uct_device_ep_h device_ep, unsigned channel_id,
+        uint64_t *consumer_index_p, uint32_t *immediate_p)
+{
+#if UCT_RC_MLX5_GDA_SUPPORTED
+    if (device_ep->uct_tl_id == UCT_DEVICE_TL_RC_MLX5_GDA) {
+        return uct_rc_mlx5_gda_ep_poll_imm_at(device_ep, channel_id,
+                                             consumer_index_p, immediate_p);
+    }
+#endif
+    return UCS_ERR_UNSUPPORTED;
+}
+
+/**
+ * @ingroup UCT_DEVICE
+ * @brief Advances the receive consumer index and returns CQ/RQ credits.
+ *
+ * This device routine advances the shared receive index by @a consumed,
+ * releases consumed CQ entries, and replenishes RQ credits. One thread calls
+ * it after all readers have finished using those entries and their payloads.
+ * Each completed receive must be counted once, even when readers share a CQ.
+ *
+ * @param [in]  device_ep         Device endpoint to be used for the operation.
+ * @param [in]  channel_id        Channel ID whose receive queues are advanced.
+ * @param [in]  consumed          Completed receives since the previous advance.
+ * @param [out] consumer_index_p  Updated shared consumer index, wrapping at 32 bits.
+ *
+ * @return UCS_OK              - Receive credits returned and index written.
+ * @return UCS_ERR_UNSUPPORTED - Operation is unsupported by the transport.
+ * @return Error code as defined by @ref ucs_status_t
+ */
+UCS_F_DEVICE ucs_status_t uct_device_ep_advance_rx(
+        uct_device_ep_h device_ep, unsigned channel_id, uint64_t consumed,
+        uint64_t *consumer_index_p)
+{
+#if UCT_RC_MLX5_GDA_SUPPORTED
+    if (device_ep->uct_tl_id == UCT_DEVICE_TL_RC_MLX5_GDA) {
+        return uct_rc_mlx5_gda_ep_advance_rx(device_ep, channel_id, consumed,
+                                            consumer_index_p);
+    }
+#endif
+    return UCS_ERR_UNSUPPORTED;
+}
+
