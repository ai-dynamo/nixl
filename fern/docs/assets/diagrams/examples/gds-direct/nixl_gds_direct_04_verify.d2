# NIXL GDS Direct Storage — Phase 4: Verify & Teardown

shape: sequence_diagram

conductor: Conductor {
  class: controller
}
agent: "NIXL Agent\n(\"GDSTester\")" {
  class: agent
}
storage: "Local Storage\n(NVMe / File)" {
  class: external
}

conductor -> conductor: "4.1 verify_transfer(buf1, buf2) — compare 0xba" {
  class: call
}
agent -> agent: "4.2 release_xfer_handle(write_handle)" {
  class: cleanup
}
agent -> agent: "4.3 release_xfer_handle(read_handle)" {
  class: cleanup
}
agent -> agent: "4.4 deregister_memory(DRAM descs)" {
  class: internal
}
agent -> agent: "4.5 deregister_memory(FILE descs)" {
  class: internal
}
conductor -> conductor: "4.6 free_passthru(buf1, buf2)" {
  class: cleanup
}
conductor -> storage: "4.7 close(fd)" {
  class: cleanup
}
