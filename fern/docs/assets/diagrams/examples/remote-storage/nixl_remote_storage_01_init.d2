# NIXL Remote Storage — Phase 1: Initialization

shape: sequence_diagram

client: "Client\n(NIXL Agent)" {
  class: agent
}
server: "Storage Server\n(NIXL Agent)" {
  class: agent
}

client -> client: "1.1 create_agent(\"client\")" {
  class: internal
}
client -> client: "1.2 create_backend(\"GDS_MT\" / \"POSIX\")" {
  class: internal
}
client -> client: "1.3 create_backend(\"UCX\")" {
  class: internal
}
client -> client: "1.4 register_memory(VRAM)" {
  class: call
}
client -> client: "1.5 register_memory(FILE)" {
  class: call
}

server -> server: "1.6 create_agent(\"server\")" {
  class: internal
}
server -> server: "1.7 create_backend(\"GDS_MT\" / \"POSIX\")" {
  class: internal
}
server -> server: "1.8 create_backend(\"UCX\")" {
  class: internal
}
server -> server: "1.9 register_memory(DRAM)" {
  class: call
}
server -> server: "1.10 register_memory(FILE)" {
  class: call
}
